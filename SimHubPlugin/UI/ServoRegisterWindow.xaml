<Window x:Class="DiyBeltTensioner.UI.ServoRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Servo Register Editor - iSV57" Height="720" Width="940" MinHeight="500" MinWidth="760"
        Background="#202020" Foreground="#FFDADADA" WindowStartupLocation="CenterScreen">

    <!-- Layout and styles of the servo register window of the DIY FFB Pedal plugin -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyBeltTensioner;component/UI/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#FF303030" />
                <Setter Property="Foreground" Value="#FFD0D0D0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="BorderBrush" Value="#FF444444" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <Style x:Key="RowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="#FF262626" />
                <Setter Property="Height" Value="24" />
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FF2E2E2E" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF3A3A5A" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FF2D5A8E" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#FFDADADA" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="Transparent" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF383838" />
                <Setter Property="Foreground" Value="#FFECECEC" />
                <Setter Property="BorderBrush" Value="#FF555555" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Height" Value="26" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF4C4C4C" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF777777" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF222222" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="#FF1E5F99" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#FF3A85C8" />
            </Style>

            <Style x:Key="BarText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFCCCCCC" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FF2B2B2B" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" BorderBrush="#FF444444" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Servo:" Style="{StaticResource BarText}" FontWeight="Bold" Margin="0,0,6,0" />
                    <ComboBox x:Name="ComboServo" Width="70" Height="24" SelectedIndex="0" SelectionChanged="ComboServo_SelectionChanged">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnLoad" Content="Load from servo" Style="{StaticResource PrimaryToolbarButtonStyle}" Click="BtnLoad_Click"
                            ToolTip="Reads all 305 registers from the servo (DUMP_SERVO, takes a few seconds)" />
                    <Button x:Name="BtnWriteTuned" Content="Write tuned set" Style="{StaticResource ToolbarButtonStyle}" Click="BtnWriteTuned_Click"
                            ToolTip="Writes the tuned parameter set of the firmware into the servo EEPROM (FLASH_SERVO)" />
                    <Button x:Name="BtnSave" Content="Save to EEPROM" Style="{StaticResource ToolbarButtonStyle}" Click="BtnSave_Click"
                            ToolTip="Stores the current servo values permanently (SERVO_SAVE); power cycle the servo afterwards" />
                    <Button x:Name="BtnExport" Content="Export" Style="{StaticResource ToolbarButtonStyle}" Click="BtnExport_Click"
                            ToolTip="Saves the live values to a CSV file" />
                    <Button x:Name="BtnImport" Content="Import" Style="{StaticResource ToolbarButtonStyle}" Click="BtnImport_Click" Margin="0"
                            ToolTip="Loads a CSV file and writes the differing values to the servo" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filter -->
        <Border Grid.Row="1" Background="#FF282828" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" BorderBrush="#FF3C3C3C" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Filter / Search:" Style="{StaticResource BarText}" Foreground="#FFAAAAAA" Margin="0,0,6,0" />
                    <TextBox x:Name="TextSearch" Width="200" Height="22" VerticalContentAlignment="Center" Background="#FF1E1E1E" Foreground="White"
                             BorderBrush="#FF555555" Padding="4,1" TextChanged="TextSearch_TextChanged"
                             ToolTip="Register (Pr1.00), address (0x0019) or part of the name" />
                    <Button Content="Clear" Width="50" Height="22" Margin="5,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="BtnClearSearch_Click" />
                    <CheckBox x:Name="CheckDiffOnly" Content="Only differing" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="14,0,0,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Tip: double click a 'Live (Servo)' cell to edit, Enter writes the value to the servo."
                           Foreground="#FF888888" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Register table -->
        <Border Grid.Row="2" Background="#FF242424" CornerRadius="4" BorderBrush="#FF444444" BorderThickness="1">
            <DataGrid x:Name="RegisterGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      AlternationCount="2"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#FF3E3E3E"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0"
                      ColumnHeaderStyle="{StaticResource HeaderStyle}"
                      RowStyle="{StaticResource RowStyle}"
                      CellStyle="{StaticResource CellStyle}"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      BeginningEdit="Grid_BeginningEdit"
                      CellEditEnding="Grid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Register" Width="80" IsReadOnly="True" SortMemberPath="Index">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Parameter}" ToolTip="{Binding Address}" Foreground="#FF9ECFFF" FontWeight="SemiBold" VerticalAlignment="Center" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="70" IsReadOnly="True" SortMemberPath="Index" />

                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="Live (Servo)" Width="110" SortMemberPath="LiveValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LiveDisplay}" Foreground="{Binding LiveColor}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="1" BorderBrush="#FF1E5F99"
                                         Background="#FF333333" Foreground="White" Padding="2,0" Loaded="EditBox_Loaded" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tuned (firmware)" Width="120" IsReadOnly="True" SortMemberPath="TunedValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TunedDisplay}" Foreground="#FF888888" VerticalAlignment="Center" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="State" Width="95" IsReadOnly="True" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding State}" Foreground="{Binding LiveColor}" VerticalAlignment="Center" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Background="#FF1E1E1E" CornerRadius="4" Padding="10,6" Margin="0,8,0,0" BorderBrush="#FF383838" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TextState" Text="Ready" Style="{StaticResource BarText}" />
                    <ProgressBar x:Name="Progress" Width="180" Height="14" Margin="12,0,0,0" Maximum="305" Visibility="Collapsed" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TextSummary" DockPanel.Dock="Right" Text="305 registers" Style="{StaticResource BarText}" Foreground="#FF888888" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
