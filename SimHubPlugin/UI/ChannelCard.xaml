<UserControl x:Class="DiyBeltTensioner.UI.ChannelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DiyBeltTensioner.UI">

    <!-- One belt channel on the SETUP tab: COM port, status, pitch, working range -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyBeltTensioner;component/UI/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SmallPill" TargetType="Button" BasedOn="{StaticResource ModernPillButton}">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0">
        <StackPanel>
            <!-- Header -->
            <DockPanel>
                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="10" Height="10" Fill="#FF666666" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TextStatus" DockPanel.Dock="Right" Style="{StaticResource SmallText}" Foreground="#FFB0B0B0" Text="not connected" />
                <TextBlock x:Name="TextTitle" Text="BELT" FontFamily="Arial Black" FontSize="15" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="TextTelemetry" Style="{StaticResource HintText}" Margin="18,2,0,0" Text="" />

            <!-- Connection -->
            <TextBlock Text="COM port" Style="{StaticResource SmallText}" Foreground="#FFABB4BE" Margin="0,10,0,3" />
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BtnConnect" Content="Connect" Style="{StaticResource ConnectPillButton}"
                        Width="82" Height="24" Margin="6,0,0,0" Click="BtnConnect_Click" />
                <ComboBox x:Name="ComboPort" Height="24" FontSize="11" DisplayMemberPath="DisplayName"
                          SelectionChanged="ComboPort_SelectionChanged" DropDownOpened="ComboPort_DropDownOpened">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </DockPanel>
            <TextBlock x:Name="TextFirmware" Style="{StaticResource HintText}" Margin="0,3,0,0" Text="" />

            <Rectangle Height="1" Fill="#FF3A3A3A" Margin="0,10,0,10" />

            <!-- Mechanics -->
            <StackPanel x:Name="PanelMechanics">
                <DockPanel Margin="0,0,0,8">
                    <ComboBox DockPanel.Dock="Right" x:Name="ComboPitch" Width="70" Height="22" FontSize="11" IsEditable="True"
                              SelectionChanged="ComboPitch_SelectionChanged" LostFocus="ComboPitch_LostFocus" KeyUp="ComboPitch_KeyUp"
                              ToolTip="Spindle pitch of the linear module in mm per motor revolution" />
                    <TextBlock Text="Spindle pitch (mm/rev):" Style="{StaticResource SmallText}" />
                </DockPanel>
                <ui:LabeledSlider x:Name="SliderRange" Title="Working range" Unit="mm" Minimum="5" Maximum="500" Step="0.5" Decimals="1"
                                  Hint="Usable stroke of the actuator between the end stops" />
                <Button x:Name="BtnMeasure" Style="{StaticResource SmallPill}" HorizontalAlignment="Left" Click="BtnMeasure_Click"
                        ToolTip="Sensorless homing to both end stops; the measured distance can be taken as working range">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="12" Height="12" Source="{StaticResource Target}" Margin="0,0,5,0" />
                        <TextBlock Text="Auto-detect range" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Rectangle Height="1" Fill="#FF3A3A3A" Margin="0,10,0,10" />

            <!-- Quick actions -->
            <WrapPanel>
                <Button x:Name="BtnHome" Style="{StaticResource SmallPill}" Click="BtnHome_Click" ToolTip="Sensorless homing">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="12" Height="12" Source="{StaticResource Target}" Margin="0,0,5,0" />
                        <TextBlock Text="Home" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnPark" Style="{StaticResource SmallPill}" Click="BtnPark_Click" ToolTip="Move to the park position">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="12" Height="12" Source="{StaticResource Park}" Margin="0,0,5,0" />
                        <TextBlock Text="Park" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRestart" Style="{StaticResource SmallPill}" Click="BtnRestart_Click" ToolTip="Restart the controller (applies saved values)">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="12" Height="12" Source="{StaticResource Restart}" Margin="0,0,5,0" />
                        <TextBlock Text="Restart" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
