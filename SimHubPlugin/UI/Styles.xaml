    <!-- Tab look of the DIY FFB Pedal plugin -->
    <ControlTemplate x:Key="PedalTabItemTemplate" TargetType="TabItem">
        <Border Name="Border" BorderThickness="1" BorderBrush="#444444" CornerRadius="3" Margin="0,0,2,0">
            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="0,0"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#4E4E4E" />
                <Setter TargetName="Border" Property="BorderBrush" Value="#666666" />
                <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="False">
                <Setter TargetName="Border" Property="Background" Value="#2A2A2A" />
                <Setter Property="TextElement.Foreground" Value="#D0D0D0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" SourceName="Border" Value="True"/>
                    <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Border" Property="Background" Value="#383838" />
                <Setter TargetName="Border" Property="BorderBrush" Value="#666666" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MainTabItem" TargetType="TabItem">
        <Setter Property="Template" Value="{StaticResource PedalTabItemTemplate}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SubTabItem" TargetType="TabItem">
        <Setter Property="Template" Value="{StaticResource PedalTabItemTemplate}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="TabHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Arial Black" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MainTabHeaderText" TargetType="TextBlock" BasedOn="{StaticResource TabHeaderText}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="PlainTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6,0,0" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Arial Black" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Arial Black" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SmallText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
        <Setter Property="Foreground" Value="#FF9AA3AD" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WarnText" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
        <Setter Property="Foreground" Value="#FFFBBF24" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IconLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="PedalSlider" TargetType="{x:Type Slider}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template" Value="{StaticResource HorizontalSliderTemplate}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
    </Style>

    <Style x:Key="ValueBox" TargetType="TextBox">
        <Setter Property="Background" Value="#FF3F3F46" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#555555" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="2,0,2,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="20" />
    </Style>
</ResourceDictionary>
